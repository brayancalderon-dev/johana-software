<Window x:Class="CalificacionesDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Johana Software" Height="680" Width="1100"
        MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        WindowState="Normal" ShowInTaskbar="True"
        Background="#F4F6FA">
    <Grid>
        <!-- Menú principal -->
        <Grid x:Name="MainMenuView" Background="#F3F6FB">
            <Grid.RowDefinitions>
                <RowDefinition Height="170"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#172B4D" Padding="42,28">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="JOHANA SOFTWARE" FontSize="31" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Sistema de gestión de calificaciones" FontSize="15" Foreground="#D6E1F2" Margin="1,7,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Width="660" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Bienvenido" FontSize="29" FontWeight="SemiBold" Foreground="#172033" HorizontalAlignment="Center"/>
                <TextBlock Text="¿Qué proceso desea realizar?" FontSize="15" Foreground="#657086" Margin="0,8,0,28" HorizontalAlignment="Center"/>
                <Button Height="112" Margin="0,0,0,16" Padding="22" Background="White" BorderBrush="#DCE4F0" BorderThickness="1" Click="OpenProjects_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                        <Border Width="58" Height="58" CornerRadius="12" Background="#E7F0FF" VerticalAlignment="Center">
                            <TextBlock Text="▣" FontSize="31" Foreground="#3478D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="Notas de proyectos" FontSize="19" FontWeight="SemiBold" Foreground="#172033"/>
                            <TextBlock Text="Ingresar y transferir calificaciones de proyectos." FontSize="13" Foreground="#657086" Margin="0,6,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="32" Foreground="#7B8799" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Button>
                <Button Height="112" Padding="22" Background="White" BorderBrush="#DCE4F0" BorderThickness="1" Click="OpenGeneral_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                        <Border Width="58" Height="58" CornerRadius="12" Background="#E4F5EC" VerticalAlignment="Center">
                            <TextBlock Text="▤" FontSize="31" Foreground="#209765" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="Notas generales" FontSize="19" FontWeight="SemiBold" Foreground="#172033"/>
                            <TextBlock Text="Gestionar calificaciones trimestrales por asignatura." FontSize="13" Foreground="#657086" Margin="0,6,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="32" Foreground="#7B8799" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="Johana Software  ·  Gestión académica" Foreground="#8993A3" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Módulo existente de notas de proyectos -->
        <Grid x:Name="ProjectsModuleView" Visibility="Collapsed" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="2,0,2,14">
            <Button Content="‹  Menú principal" Click="BackToMenu_Click" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="14,9"/>
            <StackPanel>
                <TextBlock Text="GESTOR DE CALIFICACIONES" FontSize="24" FontWeight="Bold" Foreground="#172033"/>
                <TextBlock Text="Carga varias materias, revisa las diferencias y actualiza tu Excel maestro." Foreground="#657086" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <GroupBox Header="1. EXCEL MAESTRO (.xlsx)" Padding="10" Margin="3" Background="White">
                <DockPanel LastChildFill="True">
                    <Button Content="Seleccionar maestro" Click="ChooseMaster_Click" DockPanel.Dock="Right" Padding="14,7" Margin="8,0,0,0"/>
                    <TextBox x:Name="MasterPath" IsReadOnly="True" VerticalContentAlignment="Center" Padding="7"/>
                </DockPanel>
            </GroupBox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Margin="8,0,3,0">
                <Button Content="Agregar materias (varios Excel)" Click="ChooseSources_Click" Padding="16,10" Background="#DCEBFF"/>
                <Button Content="Quitar seleccionados" Click="RemoveSources_Click" Padding="12,10" Margin="7,0,0,0"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="2" Header="2. ARCHIVOS DE MATERIAS" Padding="9" Margin="3,0,3,9" Background="White">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Puedes seleccionar varios archivos .xlsx o .xls. El programa detectará automáticamente curso, hoja, nombres, notas y materia destino." Foreground="#657086" Margin="2,0,0,8" TextWrapping="Wrap"/>
                <ListView x:Name="SourcesList" Height="105" SelectionMode="Extended">
                    <ListView.View><GridView>
                        <GridViewColumn Header="Archivo" Width="330" DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="Curso / hoja detectada" Width="210" DisplayMemberBinding="{Binding SheetName}"/>
                        <GridViewColumn Header="Materia destino" Width="170" DisplayMemberBinding="{Binding MatterName}"/>
                        <GridViewColumn Header="Estado" Width="250" DisplayMemberBinding="{Binding DetectionStatus}"/>
                    </GridView></ListView.View>
                </ListView>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="3. RESULTADOS DE ANÁLISIS" Padding="8" Margin="3" Background="White">
            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowBackground="White" AlternatingRowBackground="#F7F9FC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Archivo" Binding="{Binding SourceFile}" Width="150"/>
                    <DataGridTextColumn Header="Materia" Binding="{Binding Matter}" Width="105"/>
                    <DataGridTextColumn Header="Estudiante del maestro" Binding="{Binding Student}" Width="230"/>
                    <DataGridTextColumn Header="Nombre en materia" Binding="{Binding SourceName}" Width="220"/>
                    <DataGridTextColumn Header="Nota nueva" Binding="{Binding Grade}" Width="85"/>
                    <DataGridTextColumn Header="Nota actual" Binding="{Binding Existing}" Width="85"/>
                    <DataGridTextColumn Header="Resultado" Binding="{Binding Status}" Width="190"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <DockPanel Grid.Row="4" Margin="3,10,3,0" LastChildFill="True">
            <WrapPanel DockPanel.Dock="Left">
                <Button Content="Analizar materias" Click="Analyze_Click" Padding="16,10" Background="#DCEBFF" FontWeight="SemiBold"/>
                <Button Content="Revisar orden alfabético" Click="SortMaster_Click" Padding="14,10" Margin="7,0,0,0"/>
                <Button Content="Aplicar notas" Click="Apply_Click" Padding="16,10" Margin="7,0,0,0" Background="#DDF4E3" FontWeight="SemiBold"/>
                <Button Content="Guardar maestro como..." Click="Save_Click" Padding="14,10" Margin="7,0,0,0"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#4B566B" Text="Selecciona el Excel maestro y agrega uno o varios archivos de materias." TextWrapping="Wrap"/>
        </DockPanel>
        </Grid>

        <!-- Módulo de notas generales -->
        <Grid x:Name="GeneralModuleView" Visibility="Collapsed" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="2,0,2,12">
                <Button Content="‹  Menú principal" Click="BackToMenu_Click" DockPanel.Dock="Right" Padding="14,9"/>
                <StackPanel>
                    <TextBlock Text="NOTAS GENERALES" FontSize="24" FontWeight="Bold" Foreground="#172033"/>
                    <TextBlock Text="Transferencia de TOTAL TRIMESTRE (100%) por asignatura" Foreground="#657086" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                <GroupBox Header="1. EXCEL MAESTRO (.xlsx)" Padding="8" Margin="3" Background="White">
                    <DockPanel>
                        <Button Content="Seleccionar maestro" Click="ChooseGeneralMaster_Click" DockPanel.Dock="Right" Padding="12,7" Margin="8,0,0,0"/>
                        <TextBox x:Name="GeneralMasterPath" IsReadOnly="True" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="2. TRIMESTRE" Padding="8" Margin="3" Background="White">
                    <ComboBox x:Name="GeneralTrimesterCombo" SelectedIndex="0" SelectionChanged="GeneralTrimesterCombo_SelectionChanged" VerticalContentAlignment="Center" Padding="7">
                        <ComboBoxItem Content="Primer trimestre" Tag="1"/>
                        <ComboBoxItem Content="Segundo trimestre" Tag="2"/>
                        <ComboBoxItem Content="Tercer trimestre" Tag="3"/>
                    </ComboBox>
                </GroupBox>
            </Grid>
            <GroupBox Grid.Row="2" Header="3. ARCHIVOS DE LOS DOCENTES" Padding="8" Margin="3,0,3,8" Background="White">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Agregar Excel (varios)" Click="ChooseGeneralSources_Click" Padding="14,7" Background="#DCEBFF"/>
                        <Button Content="Quitar seleccionados" Click="RemoveGeneralSources_Click" Padding="12,7"/>
                    </StackPanel>
                    <ListView x:Name="GeneralSourcesList" Height="82" SelectionMode="Extended">
                        <ListView.View><GridView>
                            <GridViewColumn Header="Archivo" Width="330" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="Trimestre detectado" Width="180" DisplayMemberBinding="{Binding SheetName}"/>
                            <GridViewColumn Header="Asignatura" Width="210" DisplayMemberBinding="{Binding MatterName}"/>
                            <GridViewColumn Header="Estado" Width="300" DisplayMemberBinding="{Binding DetectionStatus}"/>
                        </GridView></ListView.View>
                    </ListView>
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Row="3" Header="4. REVISIÓN DE CALIFICACIONES" Padding="8" Margin="3" Background="White">
                <DataGrid x:Name="GeneralResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowBackground="White" AlternatingRowBackground="#F7F9FC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Archivo" Binding="{Binding SourceFile}" Width="150"/>
                        <DataGridTextColumn Header="Asignatura" Binding="{Binding Matter}" Width="125"/>
                        <DataGridTextColumn Header="Estudiante" Binding="{Binding Student}" Width="220"/>
                        <DataGridTextColumn Header="Nombre docente" Binding="{Binding SourceName}" Width="210"/>
                        <DataGridTextColumn Header="Nota" Binding="{Binding Grade}" Width="75"/>
                        <DataGridTextColumn Header="Nota actual" Binding="{Binding Existing}" Width="85"/>
                        <DataGridTextColumn Header="Resultado" Binding="{Binding Status}" Width="220"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <DockPanel Grid.Row="4" Margin="3,9,3,0">
                <WrapPanel DockPanel.Dock="Left">
                    <Button Content="Analizar archivos" Click="AnalyzeGeneral_Click" Padding="15,9" Background="#DCEBFF" FontWeight="SemiBold"/>
                    <Button Content="Aplicar notas" Click="ApplyGeneral_Click" Padding="15,9" Margin="7,0,0,0" Background="#DDF4E3" FontWeight="SemiBold"/>
                    <Button Content="Guardar maestro como..." Click="SaveGeneral_Click" Padding="13,9" Margin="7,0,0,0"/>
                </WrapPanel>
                <TextBlock x:Name="GeneralStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#4B566B" Text="Selecciona el maestro, el trimestre y los archivos de los docentes." TextWrapping="Wrap"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
